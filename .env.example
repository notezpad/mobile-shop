# ---- Supabase Postgres ----
# From Supabase Dashboard > Project Settings > Database > Connection string
#
# DATABASE_URL: the "Transaction" pooler connection (port 6543) — used at
# runtime by the Worker. Add ?pgbouncer=true to disable prepared statements,
# which the pooler doesn't support.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: the direct connection (port 5432) — used only for
# `prisma migrate` / `prisma db push`, never at runtime.
DIRECT_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# ---- Auth ----
# Generate a strong random secret, e.g.: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# ---- Paymob (subscription checkout) ----
# From your Paymob merchant dashboard (https://egypt.paymob.com):
#   - Profile → API Keys → API Key (server-side, secret — never expose to client)
PAYMOB_API_KEY=""
#   - Profile → API Keys → Public Key (client-side — for mobile SDK only; we don't use it here)
PAYMOB_PUBLIC_KEY="egy_pk_live_JLVJJQFdxEoLisGef0Y0OMNbRgHX8Rgj"
#   - Integrations → Integration Details → your integration's "Integration ID" (numeric, e.g. 5835805)
PAYMOB_INTEGRATION_ID="5835805"
#   - Iframe IDs (Settings) → Iframe ID for the online_new integration (numeric, e.g. 12345)
PAYMOB_IFRAME_ID=""
#   - Profile → HMAC Signature Secret (used to verify webhook callbacks)
PAYMOB_HMAC_SECRET=""

# Public app URL (no trailing slash) — used to build return URLs after Paymob payment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
