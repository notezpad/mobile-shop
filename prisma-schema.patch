+// POS v2 — Phase 3: a cashier's till session. Expected cash is computed from the user's
+// own drawer movements (CashEntry.userId, method cash/legacy-null) between openedAt and closing.
+model CashShift {
+  id           Int       @id @default(autoincrement())
+  tenantId     String
+  branchId     Int?
+  userId       String
+  openedAt     DateTime  @default(now())
+  closedAt     DateTime?
+  openingCash  Float
+  expectedCash Float?   // computed by the server at close
+  countedCash  Float?   // what the cashier actually counted
+  difference   Float?   // counted − expected (negative = shortage)
+  note         String?
+
+  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
+
+  @@index([tenantId, userId, closedAt])
+  @@index([tenantId, openedAt])
+}
