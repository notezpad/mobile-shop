{
  "name": "@mobile-shop/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/generated/database.types.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "gen-types": "supabase gen types typescript --linked > src/generated/database.types.ts",
    "migrate": "supabase db push",
    "seed": "supabase db reset && pnpm exec tsx src/seed.ts",
    "studio": "supabase studio"
  },
  "dependencies": {
    "@mobile-shop/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "supabase": "^1.207.9",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
