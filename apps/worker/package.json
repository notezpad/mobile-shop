{
  "name": "@mobile-shop/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "pnpm --filter @mobile-shop/web build",
    "build": "pnpm --filter @mobile-shop/web build && wrangler deploy --dry-run",
    "deploy": "pnpm --filter @mobile-shop/web build && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.1",
    "@mobile-shop/db": "workspace:*",
    "@mobile-shop/shared": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "hono": "^4.6.4",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "@types/node": "^22.7.4",
    "eslint": "^9.12.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9",
    "wrangler": "^3.78.10"
  }
}
