# ─── App ────────────────────────────────────────────────────────────
VITE_APP_NAME=Mobile Shop ERP
VITE_APP_VERSION=0.1.0
VITE_DEFAULT_LOCALE=ar
VITE_DEFAULT_THEME=system
VITE_DEFAULT_CURRENCY=EGP
VITE_ENABLE_DEVTOOLS=false

# ─── API ────────────────────────────────────────────────────────────
# Local dev: Cloudflare Worker via `pnpm dev:worker` (defaults to port 8787)
VITE_API_URL=http://localhost:8787/api/v1

# ─── Supabase (frontend — anon key only, safe to expose) ────────────
# Local: copy from `supabase status` output after `supabase start`
# Cloud: copy from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
