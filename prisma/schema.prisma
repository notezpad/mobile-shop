// Simplified Nezam POS Schema (multi-tenant SaaS)
// Each Tenant represents a shop. All data is isolated by tenantId.

generator client {
  provider        = "prisma-client-js"
  // FIX Error 1102 (2026-09-27): the default Rust/WASM query engine is loaded
  // into every Cloudflare Worker isolate (tens of MB + heavy startup CPU),
  // which blows the Worker CPU/memory limit on cold starts — even for pages
  // that never touch the DB. The TypeScript "client" engine removes it.
  previewFeatures = ["driverAdapters", "queryCompiler"]
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via Supabase's PgBouncer, port 6543) — used at runtime
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — used only for migrations
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                     String    @id @default(cuid())
  shopName               String    @default("محل الاتصالات")
  // IANA timezone name (e.g. "Africa/Cairo", "Asia/Riyadh"). Every
  // "today" / "this month" boundary in the app is computed in THIS
  // timezone — the shop's own local day — never the server's clock and
  // never whichever employee's browser happens to load the page.
  // See src/lib/tenantTime.ts.
  timezone               String    @default("Africa/Cairo")
  phone                  String?
  address                String?
  logoPath               String?
  invoicePrefix          String    @default("INV")
  commissionVodafoneCash Float     @default(1.0)
  commissionInstapay     Float     @default(0.5)
  commissionFawry        Float     @default(1.0)
  retailEnabled          Boolean   @default(true)
  // Unit-Based Dynamic Pricing (retail piece price = cost + margin%).
  dynamicRetailPricingEnabled Boolean @default(false)
  defaultRetailMarginPercent  Float   @default(20)
  // شكل بطاقة المنتج في صفحة المنتجات: 'auto' | 'image' | 'compact'
  productCardStyle            String  @default("auto")
  // 👕 المواسم المقفولة (باقات الملابس فقط) — JSON array لأسماء مواسم مقفولة
  // مثال: '["SUMMER"]' = الصيف مقفول في المخزن الداخلي.
  // بيتحدث فقط من معالج المواسم (POST /api/products/seasonal) — بيدخل الفلتر
  // الذكي: عرض المنتجات الافتراضي (view=active) يستبعد أصناف المواسم المقفولة.
  closedSeasons               String  @default("[]")
  status                 String    @default("active")
  ownerEmail             String?
  ownerPhone             String?
  adminNotes             String?
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())

  users             User[]
  products          Product[]
  categories        Category[]
  customers         Customer[]
  sales             Sale[]
  maintenanceOrders MaintenanceOrder[]
  transactions      Transaction[]
  cashEntries       CashEntry[]
  payments          Payment[]
  subscriptions     Subscription[]
  activationCodes   ActivationCode[]
  branches          Branch[]
  stockMovements    StockMovement[]
  transfers         Transfer[]
  stocktakes        Stocktake[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  supplierPayments  SupplierPayment[]
  expenses          Expense[]
  notifications     Notification[]
  demoRecords       DemoRecord[]
  hrEmployees       Employee[]
  hrSettings        HrSettings?
  payrollRuns       PayrollRun[]

  // Notification preferences
  notifyLowStock            Boolean @default(true)
  notifyExpiringSubscription Boolean @default(true)
  notifyNewSales            Boolean @default(false)
}

model Plan {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  description    String?
  priceMonthly   Float    @default(0)
  priceYearly    Float    @default(0)
  maxUsers       Int      @default(1)
  maxProducts    Int      @default(50)
  maxBranches    Int      @default(1)
  trialDays      Int      @default(0)
  features       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  // Vertical axis: "electronics" (mobile/computer) | "fashion" (clothing/shoes)
  // | "food" (grocery / butcher / عطارة / منظفات — المواد الغذائية)
  businessType   String   @default("electronics")
  // JSON string[] of ViewKey values — null means all modules (legacy plans)
  enabledModules String?
  // JSON string[] of fine-grained capabilities (e.g. "multi_unit","collections")
  capabilities   String?

  // 🥬 2026-10-12 (food vertical): ظهور الباقة —
  //   'public'  = تظهر في اللاندينج/الأسعار/التسجيل الذاتي (زي الـ 4 باقات الأساسية)
  //   'hidden'  = باقة مخفية للأدمن فقط: مش بتظهر في أي مكان عام، بتتسند
  //               للمحلات من لوحة الأدمن أو عبر أكواد التفعيل. مناسبة
  //               للأنشطة اللي الطلب عليها قليل (مواد غذائية/عطارة/مجمدات...)
  //               حيث صاحب المنصة عايز يدير المتابعة يدوياً من غير ما
  //               يعقّد صفحة الأسعار للزوار.
  visibility     String   @default("public") // public | hidden

  subscriptions   Subscription[]
  activationCodes ActivationCode[]
}

model Subscription {
  id            Int      @id @default(autoincrement())
  tenantId      String
  planId        Int
  status        String   @default("active")
  startDate     DateTime @default(now())
  endDate       DateTime
  period        String   @default("monthly")
  amountPaid    Float    @default(0)
  paymentMethod String?
  paymentNote   String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([endDate])
}

model ActivationCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  planId     Int
  period     String    @default("monthly")
  tenantId   String?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String?
  notes      String?

  // 🛡️ 2026-09-21 (Subscription Codes Enhancement):
  // Custom duration in days — when set, overrides the monthly/yearly/trial
  // period and gives the redeemed subscription a custom length.
  // Example: durationDays=45 → subscription lasts exactly 45 days from redeem.
  durationDays Int?

  // Optional code-level expiry — when set, the code cannot be redeemed after
  // this date. Useful for promotional codes that should expire regardless of
  // being redeemed. Null = code never expires (only single-use).
  expiresAt DateTime?

  // Optional pre-assignment — when set, ONLY this tenant can redeem the code.
  // Any other tenant trying to redeem gets a "not assigned to your account" error.
  // Null = any authenticated tenant can redeem.
  assignedTenantId String?

  // Optional batch label for grouping codes by marketing campaign / month / etc.
  // Example: "december-promo-2026" or "renewal-batch-q4"
  batchLabel String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  plan   Plan    @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([tenantId])
  @@index([assignedTenantId])
  @@index([batchLabel])
}

model Branch {
  id        Int      @id @default(autoincrement())
  tenantId  String
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users          User[]
  products       Product[]
  sales          Sale[]
  stockMovements StockMovement[]
  transfersFrom  Transfer[]      @relation("TransferFrom")
  transfersTo    Transfer[]      @relation("TransferTo")
  stocktakes     Stocktake[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@index([tenantId])
}

model User {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    Int?
  name        String
  email       String    @unique
  password    String
  role           String    @default("EMPLOYEE")
  active         Boolean   @default(true)
  permissions    String?   // JSON: string[] of module keys; null = يشوف كل الباقة
  canViewProfits Boolean   @default(false) // هل يقدر يشوف الأرباح والتكاليف؟
  lastLoginAt    DateTime?
  passwordChangedAt DateTime? // يُبطل جلسات SUPER_ADMIN الأقدم منه
  createdAt      DateTime  @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])
  passwordResetTokens PasswordResetToken[]

  @@index([branchId])
}

model Product {
  id          Int      @id @default(autoincrement())
  tenantId    String
  branchId    Int?
  name        String
  category    String?
  // 🏬 2026-10-18: الباركود فريد جوه (المحل + الفرع) مش على مستوى النظام كله —
  // الفريدية بتتفرض بـ partial unique index في migration 20261018_branch_barcodes...
  // (Prisma مابيعبّرش عن expression index، فمفيش @unique هنا)
  barcode     String?
  price       Float    @default(0)
  cost        Float    @default(0)
  // 🥬 2026-10-12 (food vertical): الكمية بقى Float عشان منتجات البيع بالوزن
  // (لحمة/فراخ/بهارات/أجبان...) تتحسب بالكيلو بكسور — 45.5 كيلو مخزون،
  // بيعة 1.65 كيلو. منتجات القطع العادية بتفضل أعداد صحيحة (45.0) فمفيش
  // أي تغيير في سلوكها.
  quantity    Float    @default(0)
  // 🥬 2026-10-12: حد التنبيه بقى Float كمان (مثلاً التنبيه عند 0.5 كيلو).
  minQuantity Float    @default(1)
  // 🥬 2026-10-12 (food vertical): بيع بالوزن — لما true:
  //   - السعر = سعر الكيلو
  //   - الكمية في الـ POS بتتقبل كسور (1.65) بأزرار +0.5 سريعة
  //   - المخزون/المشتريات/الجرد/المرتجعات كلها بالكيلو
  // بتتسجل فقط للمحلات الـ businessType بتاعها 'food' (تتقص في الـ API).
  soldByWeight Boolean @default(false)
  // 🥬 2026-10-12 (food vertical): اسم وحدة المنتج بالمفرد — علبة / كيس / برطمان /
  // زجاجة / كرتونة ... بيظهر في نقطة البيع والسلة والمبيعات والمخزون بدل «قطعة».
  // null = «قطعة» (الافتراضي — المنتجات القديمة وباقات الأزياء/الإلكترونيات مش بتتأثر).
  // بيتسجل فقط للمحلات الـ businessType بتاعها 'food' (بيتقص في الـ API).
  unitLabel   String?
  // Unit-Based Dynamic Pricing: per-product override of the tenant's default
  // retail margin %. null = fall back to Tenant.defaultRetailMarginPercent.
  retailMarginPercent Float?
  // 👕 2026-10-22 (المخزن الداخلي — فاشون فقط): تقسيمة الموقع جوّه المنتج نفسه
  //   الإجمالي (quantity) = المعروض (displayQty) + في المخزن الداخلي (مشتق)
  // الموسم: ALL_YEAR (افتراضي — مش بيتأثر بإغلاق الموسم) / SUMMER / WINTER.
  // بتتسجل فقط للمحلات الـ businessType بتاعها 'fashion' (تتقص في الـ API
  // — نفس أسلوب soldByWeight الغذائي). للحالات كلها: 0 <= displayQty <= quantity.
  season     String @default("ALL_YEAR")
  displayQty Float  @default(0)
  imagePath   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Fashion: collection field only (used for bulk collection discounts).
  collection String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id])
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  transferItems      TransferItem[]
  stocktakeItems     StocktakeItem[]
  purchaseOrderItems PurchaseOrderItem[]
  units              ProductUnit[]
  variants           ProductVariant[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, category])
  @@index([tenantId, collection])
  @@index([branchId])
  @@index([barcode])
}

// Wholesale unit (e.g. "قطعة" / "نص دستة" / "دستة" / "كرتونة").
// Simple factor-based unit only: 1 unit = factor pieces of the same product.
model ProductUnit {
  id        Int    @id @default(autoincrement())
  productId Int
  name      String
  price     Float?
  barcode   String? @unique
  factor    Int
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@unique([productId, name])
  @@index([productId])
}

// Product variant: one row per size/color combination, with its own stock and barcode.
model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  size      String?
  color     String?
  // 🏬 2026-10-18: فريد جوه المنتج (index) وجوه نفس الفرع (trigger) — migration 20261018
  barcode   String?
  quantity  Int      @default(0)
  // 👕 2026-10-22 (المخزن الداخلي): الكمية المعروضة من هذا اللون/المقاس —
  // الباقي (quantity - displayQty) في المخزن الداخلي. 0 <= displayQty <= quantity.
  displayQty Int     @default(0)
  createdAt DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@index([productId])
  @@index([barcode])
}

model Category {
  id       Int    @id @default(autoincrement())
  tenantId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Customer {
  id            Int      @id @default(autoincrement())
  tenantId      String
  name          String
  phone         String?
  balance       Float    @default(0)
  // 🛡️ 2026-09-30: حد ائتماني اختياري — لو متحدد، بيع آجل يخلي الرصيد يتعداه
  // بيت refused من الـ API (مفيش فرض تلقائي).
  creditLimit   Float?
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales       Sale[]
  payments    Payment[]
  saleReturns SaleReturn[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, phone])
}

model Payment {
  id         Int      @id @default(autoincrement())
  tenantId   String
  customerId Int
  amount     Float
  method     String   @default("cash")
  note       String?
  // 🛡️ 2026-09-30: إلغاء ناعم بدل الحذف — نفس موك SupplierPayment:
  // الدفعة بتفضل في كشف حساب العميل بعلامة "ملغية" (مين وامتى)،
  // والعكس بيتعمل على الرصيد والخزنة مرة واحدة بس (مطالبة ذرية).
  status      String    @default("active") // active | cancelled
  cancelledAt DateTime?
  cancelledBy String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // 🛡️ 2026-09-30: كان Cascade — حذف العميل كان بيمسح كل دفعاته ودينه
  // يختفي. NoAction + فحص في الـ API يمنع حذف أي عميل ليه سجل.
  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}

// ================= Suppliers & Purchasing =================

model Supplier {
  id        Int      @id @default(autoincrement())
  tenantId  String
  name      String
  phone     String?
  balance   Float    @default(0) // amount the shop OWES this supplier (credit purchases)
  createdAt DateTime @default(now())

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, phone])
}

model SupplierPayment {
  id         Int      @id @default(autoincrement())
  tenantId   String
  supplierId Int
  amount     Float
  method     String   @default("cash")
  note       String?
  // 🛡️ 2026-09-30: a cancelled payment is no longer deleted — it is marked
  // 'cancelled' (with who/when) so the supplier statement keeps its audit trail.
  status      String    @default("active") // active | cancelled
  cancelledAt DateTime?
  cancelledBy String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // 🛡️ 2026-09-29: was `onDelete: Cascade` — deleting a supplier silently wiped
  // ALL of its payments (the debt history vanished). NoAction (not Restrict) so
  // the DB blocks deleting a supplier that still has payments, while a whole-
  // tenant delete still works (NO ACTION is checked at end of statement).
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, supplierId])
  @@index([tenantId, createdAt])
}

model PurchaseOrder {
  id         Int      @id @default(autoincrement())
  tenantId   String
  branchId   Int?
  orderNo    String?
  supplierId Int?
  userId     String?
  total      Float    @default(0)
  paid       Float    @default(0)
  // 🛡️ 2026-09-30: how the `paid` amount left the shop (cash | vodafone_cash |
  // instapay | fawry). Used for the till entry and as the default refund method.
  paymentMethod String  @default("cash")
  // 🛡️ 2026-09-29: cash actually received back from the supplier through
  // returns of this order (used to cap the default refund of later returns).
  refunded   Float    @default(0)
  status     String   @default("مكتملة") // مكتملة | مرتجعة جزئياً | مرتجعة
  createdAt  DateTime @default(now())

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?             @relation(fields: [branchId], references: [id])
  // 🛡️ 2026-09-29: NoAction — a supplier with orders can no longer be deleted
  // (the default SetNull used to orphan the orders and erase the debt).
  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  items    PurchaseOrderItem[]
  returns  PurchaseReturn[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([branchId])
  // 🛡️ 2026-09-30: رقم أمر الشراء فريد داخل المحل — نفس ضمانة الفواتير
  // (كان count+1 بيتكرر مع الحذف ومع الطلبات المتزامنة).
  @@unique([tenantId, orderNo])
}

model PurchaseOrderItem {
  id              Int    @id @default(autoincrement())
  purchaseOrderId Int
  // 🛡️ 2026-09-15 (v3): nullable so a product can be hard-deleted without
  // losing purchase-order history. The `name`, `cost`, `quantity` are
  // snapshot values stored at purchase time → reports stay correct.
  productId       Int?
  // 🎨 2026-10-18: لو المنتج له ألوان/مقاسات، السطر بيشاور على الـ variant اللي
  // دخل مخزونه (بدون FK عشان حذف الـ variant ما يمسحش تاريخ الشراء).
  variantId       Int?
  name            String
  cost            Float
  // 🥬 2026-10-12: Float — شراء لحمة 45.5 كيلو من المورد
  quantity        Float
  // 🛡️ 2026-09-29: how many pieces of THIS line were already returned to the
  // supplier. Invariant: 0 <= returnedQty <= quantity (enforced atomically in
  // src/lib/purchase-return.ts).
  returnedQty     Float    @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

// 🛡️ 2026-09-29: a (partial or full) return of goods to the supplier.
//   total  = value of the goods returned (reduces what we owe the supplier)
//   refund = money the supplier actually handed back (cash enters the till)
// Net effect on Supplier.balance = -(total - refund).
model PurchaseReturn {
  id              Int      @id @default(autoincrement())
  tenantId        String
  branchId        Int?
  purchaseOrderId Int
  supplierId      Int?
  total           Float    @default(0)
  refund          Float    @default(0)
  refundMethod    String?
  note            String?
  userId          String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  items         PurchaseReturnItem[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([purchaseOrderId])
}

model PurchaseReturnItem {
  id                  Int    @id @default(autoincrement())
  purchaseReturnId    Int
  purchaseOrderItemId Int?
  productId           Int?
  variantId           Int?
  name                String
  cost                Float
  // 🥬 2026-10-12: Float — مرتجع مورد بالوزن (3.5 كيلو)
  quantity            Float

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  @@index([purchaseReturnId])
}

model Sale {
  id         Int      @id @default(autoincrement())
  tenantId   String
  branchId   Int?
  invoiceNo  String?
  customerId Int?
  userId     String?
  total      Float    @default(0)
  paid       Float    @default(0)
  // 🛡️ 2026-09-30: طريقة دفع المبلغ المدفوع في البيع (cash | vodafone_cash |
  // instapay | fawry) — نفس عمود PurchaseOrder.paymentMethod، عشان الخزنة
  // تتفصل كاش/محافظ/انستاباي على التدفق الأكبر في النظام.
  paymentMethod String @default("cash")
  // 🛡️ 2026-09-30: الكاش اللي ردّه المحل فعلاً للعميل عبر مرتجعات هذه الفاتورة
  // (بيد Cap للمرتجعات: مفيش رد أكبر من اللي اتدفعت فعلاً).
  refunded   Float    @default(0)
  // 🛡️ 2026-09-30: تاريخ استحقاق الفاتورة الآجلة (اختياري) — للتقادم والتنبيهات.
  dueDate    DateTime?
  // 🛡️ 2026-09-30: معرف رسالة مكرر من الأوفلاين (idempotency key) — retry
  // لنفس الفاتورة بيرجع الفاتورة الأصلية بدل ما يعمل نسخة تانية.
  clientRef  String?
  status     String   @default("مكتملة") // مكتملة | مرتجعة جزئياً | مرتجعة
  createdAt  DateTime @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?       @relation(fields: [branchId], references: [id])
  // 🛡️ 2026-09-30: كان SetNull افتراضياً — حذف عميل كان بيفصل فواتيره
  // ويمسح الدين. NoAction + فحص الحذف يمنع كله ده.
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: NoAction)
  items    SaleItem[]
  payments SalePayment[]
  returns  SaleReturn[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([branchId])
  // 🛡️ 2026-09-30: رقم الفاتورة فريد داخل المحل — الضمانة الأخيرة ضد تكرار
  // الأرقام مع فواتير متزامنة (التوليد نفسه جوه الـ tx + retry على P2002).
  // الـ NULLs (فواتير قديمة قبل نظام الأرقام) مسموحة في Postgres.
  @@unique([tenantId, invoiceNo])
  // 🛡️ 2026-09-30: مفتاح عدم التكرار للأوفلاين — نفس الـ clientRef مايتسجلش مرتين.
  @@unique([tenantId, clientRef])
}

model SaleItem {
  id        Int    @id @default(autoincrement())
  saleId    Int
  // 🛡️ 2026-09-15 (v3): nullable productId so a product can be hard-deleted
  // WITHOUT losing the sale history. When a product is deleted via the
  // `mode=archive` flow, the FK is set to NULL but name/price/cost/quantity
  // (snapshot values stored at sale time) remain intact → reports + cash
  // drawer + accounting stay correct.
  productId Int?
  name      String
  price     Float
  // 🥬 2026-10-12: Float — منتجات البيع بالوزن بتتباع بكسور (1.65 كيلو)
  // والوحدات بتتبقى أعداد صحيحة برضه متوافقة.
  quantity  Float        // total pieces (kept for legacy reports)
  // 🛡️ 2026-09-30: كام قطعة من هذا السطر رجعت بالفعل عبر مرتجع البيع.
  // Invariant: 0 <= returnedQty <= quantity (مطالبة ذرية في src/lib/sale-return.ts).
  returnedQty Float  @default(0)
  cost      Float  @default(0)

  // Optional wholesale-unit metadata — for invoice display
  unitId       Int?
  unitLabel    String?
  // 🥬 2026-10-12: Float (توافق مع الكميات العشرية)
  unitQuantity Float?
  // 🥬 2026-10-12 (food vertical): لقطة من Product.unitLabel وقت البيع (علبة/كيس/...)
  // عشان الفاتورة القديمة تفضل تعرض الوحدة صح حتى لو المنتج اتعدّل بعدين.
  // null = «قطعة». (unitLabel فوق = وحدة الجملة، دي = وحدة المنتج نفسه.)
  pieceLabel   String?

  // Optional link to the specific size/color variant sold
  variantId Int?

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  unit    ProductUnit?    @relation(fields: [unitId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([unitId])
  @@index([variantId])
}

model SalePayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  amount    Float
  note      String?
  // 🛡️ 2026-09-15 (v2): link to the CashEntry created when this payment
  // was recorded. This lets the DELETE sale endpoint reverse each payment's
  // cash entry via the FK link (instead of date-range guessing).
  cashEntryId Int?
  createdAt DateTime @default(now())

  sale Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashEntry CashEntry? @relation(fields: [cashEntryId], references: [id])

  @@index([saleId])
  @@index([cashEntryId])
}

// 🛡️ 2026-09-30: مرتجع بيع (جزئي أو كامل) — نفس موك PurchaseReturn بالظبط:
//   total         = قيمة البضاعة المرتجعة (بسعر البيع الفعلي)
//   exchangeTotal = قيمة بضاعة الاستبدال اللي خرجت من المخزن
//   refund        = الكاش اللي ردّه المحل للعميل فعلاً دلوقتي (≤ المدفوع غير المسترد)
//   creditApplied = الجزء اللي اتحول على حساب العميل (total − exchangeTotal − refund)
// الثابت المحاسبي: creditApplied + refund = total − exchangeTotal (لما الفرق موجب).
model SaleReturn {
  id            Int      @id @default(autoincrement())
  tenantId      String
  branchId      Int?
  saleId        Int
  customerId    Int?
  total         Float    @default(0)
  exchangeTotal Float    @default(0)
  refund        Float    @default(0)
  refundMethod  String?
  creditApplied Float    @default(0)
  note          String?
  userId        String?
  createdAt     DateTime @default(now())

  sale     Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customerId], references: [id])
  items    SaleReturnItem[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([saleId])
  @@index([customerId])
}

model SaleReturnItem {
  id           Int    @id @default(autoincrement())
  saleReturnId Int
  saleItemId   Int?
  productId    Int?
  name         String
  price        Float
  cost         Float  @default(0)
  // 🥬 2026-10-12: Float — مرتجع بيع بالوزن (0.5 كيلو لحمة)
  quantity     Float

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
}

model MaintenanceOrder {
  id           Int       @id @default(autoincrement())
  tenantId     String
  customerName String
  phone        String?
  device       String
  issue        String    @default("")
  cost         Float     @default(0)
  status       String    @default("مستلم")
  receivedAt   DateTime  @default(now())
  deliveredAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@index([tenantId, customerName])
}

model Transaction {
  id         Int      @id @default(autoincrement())
  tenantId   String
  method     String
  kind       String
  amount     Float
  commission Float    @default(0)
  note       String?
  userId     String?
  // 🛡️ 2026-09-30: إلغاء ناعم لمعاملة المحفظة بدل ما تفضل للأبد — نفس موك الدفعات.
  status      String    @default("active") // active | cancelled
  cancelledAt DateTime?
  cancelledBy String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model CashEntry {
  id        Int      @id @default(autoincrement())
  tenantId  String
  source    String
  refId     Int?
  amount    Float
  note      String?
  userId    String?
  // 🛡️ 2026-09-15 (v3): payment method for this cash entry — 'cash' |
  // 'vodafone_cash' | 'instapay' | 'fawry' | 'card' | 'bank' | null
  // (null = legacy entries before this column was added).
  // This lets the drawer be aggregated per-method (e.g. "كاش فعلي" vs
  // "فودافون كاش" vs "إنستاباي") — important for accounting because
  // Vodafone Cash is a different asset than physical cash.
  method    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // 🛡️ 2026-09-15 (v2): back-reference to SalePayment (if this CashEntry
  // was created as part of a sale payment). Nullable + optional relation.
  salePayments SalePayment[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([method])
}

// Shop running costs (rent, electricity, salaries, etc.) — admin-only.
model Expense {
  id        Int      @id @default(autoincrement())
  tenantId  String
  branchId  Int?
  category  String
  amount    Float
  note      String?
  userId    String?
  // 🛡️ 2026-09-30: مصدر المصروف لو اتولد آلياً ('damage' = خسارة هالك من
  // حركة مخزون). مصروف الهالك بيتمنع حذفه من شاشة المصروفات لأن حذف أي
  // مصروف بيضيف قيمته تاني للخزنة — وده غلط لما مفيش فلوس خرجت أصلاً.
  source    String?
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, category])
  @@index([branchId])
}

model PlatformSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @default(now())
}

// ================= Inventory =================

model StockMovement {
  id        Int      @id @default(autoincrement())
  tenantId  String
  branchId  Int?
  // 🛡️ 2026-09-15 (v3): nullable so a product can be hard-deleted without
  // losing stock-movement history (audit trail stays intact).
  productId Int?
  // 🎨 2026-10-18: الـ variant (لون/مقاس) اللي اتحرك مخزونه، null = المنتج نفسه
  variantId Int?
  // 📋 2026-10-18: سياسة الحركات اليدوية — كود السبب + مراجعة المدير لحركات الموظفين
  reasonCode  String?
  needsReview Boolean   @default(false)
  reviewedAt  DateTime?
  reviewedBy  String?
  type      String // in | out | adjust | sale | return | transfer_in | transfer_out | stocktake | warehouse_in | warehouse_out
  // 🥬 2026-10-12: Float — حركات بالوزن (بيع 1.65 كيلو / جرد -0.5)
  quantity  Float // signed: + increases, - decreases
  refType   String? // sale | transfer | stocktake | manual
  refId     Int?
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([branchId])
}

model Transfer {
  id           Int       @id @default(autoincrement())
  tenantId     String
  fromBranchId Int
  toBranchId   Int
  status       String    @default("pending") // pending | completed | cancelled
  note         String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  items      TransferItem[]

  @@index([tenantId])
  @@index([status])
}

model TransferItem {
  id         Int @id @default(autoincrement())
  transferId Int
  // 🛡️ 2026-09-15 (v3): nullable so a product can be hard-deleted without
  // losing transfer history.
  productId  Int?
  // 🎨 2026-10-18: لو المنتج له ألوان/مقاسات، السطر = لون/مقاس واحد
  variantId  Int?
  // 🥬 2026-10-12: Float — تحويل 12.5 كيلو بين فروع
  quantity   Float

  transfer Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id])

  @@index([transferId])
}

model Stocktake {
  id          Int       @id @default(autoincrement())
  tenantId    String
  branchId    Int?
  status      String    @default("draft") // draft | committed
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  committedAt DateTime?

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch?         @relation(fields: [branchId], references: [id])
  items  StocktakeItem[]

  @@index([tenantId])
}

model StocktakeItem {
  id          Int @id @default(autoincrement())
  stocktakeId Int
  // 🛡️ 2026-09-15 (v3): nullable so a product can be hard-deleted without
  // losing stocktake history (the systemQty/countedQty/diff stay intact).
  productId   Int?
  // 🎨 2026-10-18: جرد لون/مقاس معيّن (systemQty/countedQty بتاعته هو)
  variantId   Int?
  // 🥬 2026-10-12: Float — جرد بالكيلو (نظامي 45.5 / مُحصى 44.25 / فرق -1.25)
  systemQty   Float
  countedQty  Float
  diff        Float @default(0)

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([stocktakeId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  tenantId  String
  userId    String?
  type      String    @default("info")
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ================= Marketing & Tracking =================

// 📊 سجل أحداث التتبع — مصدر الحقيقة لـ:
//   1) Idempotency: الفهرس الفريد (provider + eventId) يمنع إرسال نفس
//      الحدث مرتين (Webhook retries / صفحة النجاح Refresh / إعادة فتح).
//   2) شاشة Debug/Test في لوحة الأدمن (اسم الحدث، المنصة، الحالة، الخطأ).
//   ⚠️ لا يحتوي أبداً على بيانات حساسة خام (كلمات مرور/بطاقات/توكنات).
//      بيانات matching تُخزَّنهازية فقط (SHA-256) داخل payload.
model TrackingEvent {
  id             Int      @id @default(autoincrement())
  // معرّف ثابت وفريد لكل عملية تجارية، مثال:
  //   purchase-sub-123 | trial-sub-45 | checkout-sub-45 | signup-ckxxx
  // نفس المعرّف يُستخدم من Browser و Server لضمان Deduplication.
  eventId        String
  eventName      String // PageView | ViewContent | CompleteRegistration | StartTrial | InitiateCheckout | Purchase
  provider       String // meta | tiktok | ga4 | google_ads
  source         String // server | browser
  status         String   @default("sent") // sent | failed | skipped
  error          String?
  // JSON sanitized — قيم تقنية فقط (value/currency/plan/ids) بدون PII خام
  payload        String?
  subscriptionId Int?
  createdAt      DateTime @default(now())

  @@unique([provider, eventId])
  @@index([eventName, createdAt])
  @@index([createdAt])
  @@index([subscriptionId])
}

// 🧭 إسناد مصادر الاكتساب (Attribution) لكل مستخدم — أول وآخر Touch.
// تُلتقط من URL (utm_* + gclid/fbclid/ttclid) في المتصفح ثم تُحفظ
// عند إنشاء الحساب. جدول مستقل حتى لا يُغيّر جدول User الأساسي.
model UserAttribution {
  userId String @id

  firstTouchSource   String?
  firstTouchMedium   String?
  firstTouchCampaign String?
  firstTouchContent  String?
  firstTouchTerm     String?
  firstTouchAt       DateTime?

  lastTouchSource   String?
  lastTouchMedium   String?
  lastTouchCampaign String?
  lastTouchContent  String?
  lastTouchTerm     String?
  lastTouchAt       DateTime?

  // معرّفات النقر من منصات الإعلان (حسب المتاح)
  gclid       String?
  fbclid      String?
  ttclid      String?
  wbraid      String?
  gbraid      String?
  // سياق الهبوط
  landingPage String?
  referrer    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastTouchSource])
  @@index([firstTouchSource])
}

// 🔗 مكتبة حملات UTM — روابط مُنسّقة لمنصات الإعلان (Funnel/Attribution تكملتها)
model UtmCampaign {
  id             Int      @id @default(autoincrement())
  name           String // اسم الحملة (للعرض)
  platform       String // meta | google | tiktok | custom
  destinationUrl String // الرابط الأساسي Canonical (بدون UTM)
  utmSource      String
  utmMedium      String
  utmCampaign    String
  utmContent     String?
  utmTerm        String?
  utmId          String?
  fullUrl        String // الرابط الكامل النهائي
  urlHash        String @unique // SHA-256 للرابط الكامل — منع التكرار
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([platform])
  @@index([utmCampaign])
  @@index([archived, createdAt])
}

// 🛡️ 2026-10-12 — حد التسجيل لكل IP (مكافحة تكرار التجارب المجانية).
// بنخزّن SHA-256 للـ IP فقط. الكود في src/lib/signup-guard.ts.
model SignupAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// حد محاولات الدخول الفاشلة (مخزّن hash للإيميل/الـ IP فقط)
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  keyHash   String
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
}

// 🔑 2026-10-24: توكنات استعادة كلمة المرور — بنخزّن SHA-256 للتوكن بس، صلاحية 30 دقيقة، مرة واحدة
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

// سجل نشاط الأدمن (Audit Log) — للقراءة فقط من الواجهة، ما فيش تعديل/حذف
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String?
  actorEmail String?
  action     String   // مثال: tenant.suspend / impersonate.start / auth.password_change
  targetType String?  // tenant | subscription | plan | code | settings | user
  targetId   String?
  details    String?  // JSON صغير — ممنوع فيه أسرار/كلمات مرور
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetId])
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  tenantId  String?
  toHash    String?  // SHA-256 للعنوان — مفيش إيميلات خام في السجل
  kind      String   // welcome | renewal | expired | test
  status    String   @default("sent") // sent | failed
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, kind, createdAt])
}

// 🆕 2026-10-22: قيود تعديل الرصيد — الرصيد الافتتاحي عند الترحيل من نظام/دفتر
// قديم + أي تسوية لاحقة لرصيد عميل أو مورد (بسبب إجباري ومن أدمن).
// ⚠️ حركة دفاتر محضة — لا تنشئ CashEntry أبداً (الديون القديمة مش نقدية).
// 🎁 2026-10-23: تسجيل الصفوف التجريبية (بيانات أول دخول) — الدوال في prisma/sql/demo-data-v1.sql
model DemoRecord {
  id       BigInt @id @default(autoincrement())
  tenantId String
  tbl      String
  rowId    String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tbl, rowId], map: "DemoRecord_tenant_tbl_row_key")
  @@index([tenantId])
}

model BalanceEntry {
  id        Int      @id @default(autoincrement())
  tenantId  String
  kind      String   // customer | supplier
  refId     Int      // customerId أو supplierId
  delta     Float    // موقّع: + = رصيد زاد (دين على العميل / علينا للمورد)، − = رصيد قلل
  reason    String   // سبب إجباري — مثال: «رصيد افتتاحي — ترحيل من النظام القديم»
  createdBy String?  // اسم من نفذ الحركة
  createdAt DateTime @default(now())

  @@index([tenantId, kind, refId])
  @@index([tenantId, createdAt])
}

// 🛠️ 2026-10-22 (مراجعة الأرصدة الافتتاحية): موديل مفاتيح منع التكرار —
// كان موجود في migration 20261018_idempotency فقط وغايب عن الـ schema،
// فأي قاعدة جديدة تتبني بـ `prisma db push` كانت تطلع من غير الجدول ده
// وكل مسار ملفوف بـ withIdempotency (كاش/دفعات/أوامر شراء/تسويات رصيد...)
// يبوّظ 500 أول ما العميل الأوفلاين يبعت Idempotency-Key.
// أنواع الأعمدة مطابقة للـ migration بالظبط (BIGSERIAL id، TEXT tenantId).
model IdempotencyKey {
  id          BigInt   @id @default(autoincrement())
  tenantId    String
  key         String
  method      String
  path        String
  // NULL = لسه بتتنفذ، وإلا كود الرد الأصلي ونصه (لإعادة الإرسال الآمنة)
  status      Int?
  body        String?
  contentType String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, key], map: "IdempotencyKey_tenant_key_key")
  @@index([createdAt], map: "IdempotencyKey_createdAt_idx")
}


// ═══════════════════════════════════════════════════════════════
// 👥 الموارد البشرية — المرحلة 1 (2026-10-28)
// الموظف مختلف عن المستخدم (User): ممكن موظف بدون حساب دخول.
// الفلوس Float زي باقي النظام. الـ SQL الفعلي: prisma/migrations/20261028_hr_phase1
// ═══════════════════════════════════════════════════════════════
model Employee {
  id           Int      @id @default(autoincrement())
  tenantId     String
  branchId     Int?
  userId       String?   // ربط اختياري بحساب دخول
  name         String
  phone        String?
  jobTitle     String?
  baseSalary   Float    @default(0)
  hireDate     DateTime @default(now())
  weeklyOffDay Int      @default(5) // 0=الأحد … 6=السبت (الافتراضي الجمعة)
  pinHash      String?  // PIN كشك الحضور (مُجزّأ)
  active       Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendance AttendanceRecord[]
  advances   EmployeeAdvance[]
  payslips   Payslip[]

  @@index([tenantId])
  @@index([tenantId, active])
}

model HrSettings {
  tenantId     String   @id
  shiftStart   String   @default("10:00")
  shiftHours   Float    @default(8)
  graceMinutes Int      @default(15)
  lateMode     String   @default("per_minute") // none | per_minute
  dayDivisor   Int      @default(30)           // 0 = عدد أيام الشهر الفعلي
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id          Int      @id @default(autoincrement())
  tenantId    String
  employeeId  Int
  date        String   // YYYY-MM-DD بتوقيت المحل
  status      String   // present | late | absent | leave
  checkIn     DateTime?
  checkOut    DateTime?
  lateMinutes Int      @default(0)
  note        String?
  source      String   @default("manual") // manual | kiosk
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

model EmployeeAdvance {
  id          Int      @id @default(autoincrement())
  tenantId    String
  employeeId  Int
  amount      Float
  installment Float    // القسط الشهري
  remaining   Float
  status      String   @default("open") // open | settled | cancelled
  method      String   @default("cash")
  note        String?
  createdBy   String?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId])
}

model PayrollRun {
  id        Int       @id @default(autoincrement())
  tenantId  String
  month     String    // YYYY-MM
  status    String    @default("draft") // draft | paid
  totalNet  Float     @default(0)
  method    String?
  paidAt    DateTime?
  createdBy String?
  createdAt DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([tenantId, month])
}

model Payslip {
  id               Int      @id @default(autoincrement())
  runId            Int
  tenantId         String
  employeeId       Int
  employeeName     String
  baseSalary       Float
  payableBase      Float    // الأساسي بعد التناسب (تعيين وسط الشهر)
  absentDays       Float    @default(0)
  absenceDeduction Float    @default(0)
  lateMinutes      Int      @default(0)
  lateDeduction    Float    @default(0)
  bonus            Float    @default(0)
  penalty          Float    @default(0)
  advanceDeduction Float    @default(0)
  net              Float    @default(0)
  note             String?

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeId])
  @@index([tenantId])
}
