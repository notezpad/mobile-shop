// Simplified Shop System Schema (multi-tenant SaaS)
// Each Tenant represents a shop. All data is isolated by tenantId.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via Supabase's PgBouncer, port 6543) — used at runtime
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — used only for migrations
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                     String    @id @default(cuid())
  shopName               String    @default("محل الاتصالات")
  // IANA timezone name (e.g. "Africa/Cairo", "Asia/Riyadh"). Every
  // "today" / "this month" boundary in the app is computed in THIS
  // timezone — the shop's own local day — never the server's clock and
  // never whichever employee's browser happens to load the page.
  // See src/lib/tenantTime.ts.
  timezone               String    @default("Africa/Cairo")
  phone                  String?
  address                String?
  logoPath               String?
  invoicePrefix          String    @default("INV")
  commissionVodafoneCash Float     @default(1.0)
  commissionInstapay     Float     @default(0.5)
  commissionFawry        Float     @default(1.0)
  wholesaleEnabled       Boolean   @default(false)
  retailEnabled          Boolean   @default(true)
  status                 String    @default("active")
  ownerEmail             String?
  ownerPhone             String?
  adminNotes             String?
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())

  users             User[]
  products          Product[]
  categories        Category[]
  customers         Customer[]
  sales             Sale[]
  maintenanceOrders MaintenanceOrder[]
  transactions      Transaction[]
  cashEntries       CashEntry[]
  payments          Payment[]
  subscriptions     Subscription[]
  activationCodes   ActivationCode[]
  branches          Branch[]
  stockMovements    StockMovement[]
  transfers         Transfer[]
  stocktakes        Stocktake[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  supplierPayments  SupplierPayment[]
  expenses          Expense[]
  notifications     Notification[]

  // Notification preferences
  notifyLowStock            Boolean @default(true)
  notifyExpiringSubscription Boolean @default(true)
  notifyNewSales            Boolean @default(false)
}

model Plan {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  description    String?
  priceMonthly   Float    @default(0)
  priceYearly    Float    @default(0)
  maxUsers       Int      @default(1)
  maxProducts    Int      @default(50)
  maxBranches    Int      @default(1)
  trialDays      Int      @default(0)
  features       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  // Vertical axis: "electronics" (mobile/computer) | "fashion" (clothing/shoes)
  businessType   String   @default("electronics")
  // JSON string[] of ViewKey values — null means all modules (legacy plans)
  enabledModules String?
  // JSON string[] of fine-grained capabilities (e.g. "multi_unit","collections")
  capabilities   String?

  subscriptions   Subscription[]
  activationCodes ActivationCode[]
}

model Subscription {
  id            Int      @id @default(autoincrement())
  tenantId      String
  planId        Int
  status        String   @default("active")
  startDate     DateTime @default(now())
  endDate       DateTime
  period        String   @default("monthly")
  amountPaid    Float    @default(0)
  paymentMethod String?
  paymentNote   String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([endDate])
}

model ActivationCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  planId     Int
  period     String    @default("monthly")
  tenantId   String?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String?
  notes      String?

  // 🛡️ 2026-09-21 (Subscription Codes Enhancement):
  // Custom duration in days — when set, overrides the monthly/yearly/trial
  // period and gives the redeemed subscription a custom length.
  // Example: durationDays=45 → subscription lasts exactly 45 days from redeem.
  durationDays Int?

  // Optional code-level expiry — when set, the code cannot be redeemed after
  // this date. Useful for promotional codes that should expire regardless of
  // being redeemed. Null = code never expires (only single-use).
  expiresAt DateTime?

  // Optional pre-assignment — when set, ONLY this tenant can redeem the code.
  // Any other tenant trying to redeem gets a "not assigned to your account" error.
  // Null = any authenticated tenant can redeem.
  assignedTenantId String?

  // Optional batch label for grouping codes by marketing campaign / month / etc.
  // Example: "december-promo-2026" or "renewal-batch-q4"
  batchLabel String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  plan   Plan    @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([tenantId])
  @@index([assignedTenantId])
  @@index([batchLabel])
}

model Branch {
  id        Int      @id @default(autoincrement())
  tenantId  String
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users          User[]
  products       Product[]
  sales          Sale[]
  stockMovements StockMovement[]
  transfersFrom  Transfer[]      @relation("TransferFrom")
  transfersTo    Transfer[]      @relation("TransferTo")
  stocktakes     Stocktake[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@index([tenantId])
}

model User {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    Int?
  name        String
  email       String    @unique
  password    String
  role        String    @default("EMPLOYEE")
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Product {
  id          Int      @id @default(autoincrement())
  tenantId    String
  branchId    Int?
  name        String
  category    String?
  barcode     String?  @unique
  price       Float    @default(0)
  cost        Float    @default(0)
  quantity    Int      @default(0)
  minQuantity Int      @default(1)
  imagePath   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Fashion: collection field only (used for bulk collection discounts).
  collection String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id])
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  transferItems      TransferItem[]
  stocktakeItems     StocktakeItem[]
  purchaseOrderItems PurchaseOrderItem[]
  units              ProductUnit[]
  variants           ProductVariant[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, category])
  @@index([tenantId, collection])
  @@index([branchId])
}

// Wholesale unit (e.g. "قطعة" / "نص دستة" / "دستة" / "كرتونة").
// Simple factor-based unit only: 1 unit = factor pieces of the same product.
model ProductUnit {
  id        Int    @id @default(autoincrement())
  productId Int
  name      String
  price     Float?
  barcode   String? @unique
  factor    Int
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@unique([productId, name])
  @@index([productId])
}

// Product variant: one row per size/color combination, with its own stock and barcode.
model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  size      String?
  color     String?
  barcode   String?  @unique
  quantity  Int      @default(0)
  createdAt DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@index([productId])
}

model Category {
  id       Int    @id @default(autoincrement())
  tenantId String
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Customer {
  id            Int      @id @default(autoincrement())
  tenantId      String
  name          String
  phone         String?
  balance       Float    @default(0)
  createdAt     DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments Payment[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, phone])
}

model Payment {
  id         Int      @id @default(autoincrement())
  tenantId   String
  customerId Int
  amount     Float
  method     String   @default("cash")
  note       String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}

// ================= Suppliers & Purchasing =================

model Supplier {
  id        Int      @id @default(autoincrement())
  tenantId  String
  name      String
  phone     String?
  balance   Float    @default(0) // amount the shop OWES this supplier (credit purchases)
  createdAt DateTime @default(now())

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, phone])
}

model SupplierPayment {
  id         Int      @id @default(autoincrement())
  tenantId   String
  supplierId Int
  amount     Float
  method     String   @default("cash")
  note       String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, supplierId])
  @@index([tenantId, createdAt])
}

model PurchaseOrder {
  id         Int      @id @default(autoincrement())
  tenantId   String
  branchId   Int?
  orderNo    String?
  supplierId Int?
  userId     String?
  total      Float    @default(0)
  paid       Float    @default(0)
  status     String   @default("مكتملة") // مكتملة | مرتجعة
  createdAt  DateTime @default(now())

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?             @relation(fields: [branchId], references: [id])
  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([branchId])
}

model PurchaseOrderItem {
  id              Int    @id @default(autoincrement())
  purchaseOrderId Int
  // 🛡️ 2026-09-15 (v3): nullable so a product can be hard-deleted without
  // losing purchase-order history. The `name`, `cost`, `quantity` are
  // snapshot values stored at purchase time → reports stay correct.
  productId       Int?
  name            String
  cost            Float
  quantity        Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model Sale {
  id         Int      @id @default(autoincrement())
  tenantId   String
  branchId   Int?
  invoiceNo  String?
  customerId Int?
  userId     String?
  total      Float    @default(0)
  paid       Float    @default(0)
  status     String   @default("مكتملة")
  createdAt  DateTime @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?       @relation(fields: [branchId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  payments SalePayment[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([branchId])
}

model SaleItem {
  id        Int    @id @default(autoincrement())
  saleId    Int
  // 🛡️ 2026-09-15 (v3): nullable productId so a product can be hard-deleted
  // WITHOUT losing the sale history. When a product is deleted via the
  // `mode=archive` flow, the FK is set to NULL but name/price/cost/quantity
  // (snapshot values stored at sale time) remain intact → reports + cash
  // drawer + accounting stay correct.
  productId Int?
  name      String
  price     Float
  quantity  Int         // total pieces (kept for legacy reports)
  cost      Float  @default(0)

  // Optional wholesale-unit metadata — for invoice display
  unitId       Int?
  unitLabel    String?
  unitQuantity Int?

  // Optional link to the specific size/color variant sold
  variantId Int?

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  unit    ProductUnit?    @relation(fields: [unitId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([unitId])
  @@index([variantId])
}

model SalePayment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  amount    Float
  note      String?
  // 🛡️ 2026-09-15 (v2): link to the CashEntry created when this payment
  // was recorded. This lets the DELETE sale endpoint reverse each payment's
  // cash entry via the FK link (instead of date-range guessing).
  cashEntryId Int?
  createdAt DateTime @default(now())

  sale Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashEntry CashEntry? @relation(fields: [cashEntryId], references: [id])

  @@index([saleId])
  @@index([cashEntryId])
}

model MaintenanceOrder {
  id           Int       @id @default(autoincrement())
  tenantId     String
  customerName String
  phone        String?
  device       String
  issue        String    @default("")
  cost         Float     @default(0)
  status       String    @default("مستلم")
  receivedAt   DateTime  @default(now())
  deliveredAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@index([tenantId, customerName])
}

model Transaction {
  id         Int      @id @default(autoincrement())
  tenantId   String
  method     String
  kind       String
  amount     Float
  commission Float    @default(0)
  note       String?
  userId     String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model CashEntry {
  id        Int      @id @default(autoincrement())
  tenantId  String
  source    String
  refId     Int?
  amount    Float
  note      String?
  userId    String?
  // 🛡️ 2026-09-15 (v3): payment method for this cash entry — 'cash' |
  // 'vodafone_cash' | 'instapay' | 'fawry' | 'card' | 'bank' | null
  // (null = legacy entries before this column was added).
  // This lets the drawer be aggregated per-method (e.g. "كاش فعلي" vs
  // "فودافون كاش" vs "إنستاباي") — important for accounting because
  // Vodafone Cash is a different asset than physical cash.
  method    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // 🛡️ 2026-09-15 (v2): back-reference to SalePayment (if this CashEntry
  // was created as part of a sale payment). Nullable + optional relation.
  salePayments SalePayment[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([method])
}

// Shop running costs (rent, electricity, salaries, etc.) — admin-only.
model Expense {
  id        Int      @id @default(autoincrement())
  tenantId  String
  branchId  Int?
  category  String
  amount    Float
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, category])
  @@index([branchId])
}

model PlatformSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @default(now())
}

// ================= Inventory =================

model StockMovement {
  id        Int      @id @default(autoincrement())
  tenantId  String
  branchId  Int?
  // 🛡️ 2026-09-15 (v3): nullable so a product can be hard-deleted without
  // losing stock-movement history (audit trail stays intact).
  productId Int?
  type      String // in | out | adjust | sale | return | transfer_in | transfer_out | stocktake
  quantity  Int // signed: + increases, - decreases
  refType   String? // sale | transfer | stocktake | manual
  refId     Int?
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([branchId])
}

model Transfer {
  id           Int       @id @default(autoincrement())
  tenantId     String
  fromBranchId Int
  toBranchId   Int
  status       String    @default("pending") // pending | completed | cancelled
  note         String?
  createdBy    String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromBranch Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  items      TransferItem[]

  @@index([tenantId])
  @@index([status])
}

model TransferItem {
  id         Int @id @default(autoincrement())
  transferId Int
  // 🛡️ 2026-09-15 (v3): nullable so a product can be hard-deleted without
  // losing transfer history.
  productId  Int?
  quantity   Int

  transfer Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id])

  @@index([transferId])
}

model Stocktake {
  id          Int       @id @default(autoincrement())
  tenantId    String
  branchId    Int?
  status      String    @default("draft") // draft | committed
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  committedAt DateTime?

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch?         @relation(fields: [branchId], references: [id])
  items  StocktakeItem[]

  @@index([tenantId])
}

model StocktakeItem {
  id          Int @id @default(autoincrement())
  stocktakeId Int
  // 🛡️ 2026-09-15 (v3): nullable so a product can be hard-deleted without
  // losing stocktake history (the systemQty/countedQty/diff stay intact).
  productId   Int?
  systemQty   Int
  countedQty  Int
  diff        Int @default(0)

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([stocktakeId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  tenantId  String
  userId    String?
  type      String    @default("info")
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
