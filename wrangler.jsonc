{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nezampos",
  "main": ".open-next/worker.js",
  "keep_names": false,
  "keep_vars": true,
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_process_v2",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // PERF FIX (2026-09-25): Smart Placement runs the Worker close to the
  // database instead of close to the visitor. Every page does several DB
  // round-trips, so this alone removes a large part of the slowness.
  "placement": {
    "mode": "smart"
  },
  // Recommended: create a Hyperdrive config for the same Postgres database and
  // paste its id below (see HYPERDRIVE_SETUP.md). The code picks it up
  // automatically and falls back to DATABASE_URL when it is absent.
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "<your-hyperdrive-id>" }
  // ],
  "vars": {
    "NODE_ENV": "production"
  }
}
