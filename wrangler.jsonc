{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nezampos",
  "main": ".open-next/worker.js",
  "keep_names": false,
  "keep_vars": true,
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_process_v2",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production"
  }
}
