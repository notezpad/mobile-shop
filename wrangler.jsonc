{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nezampos",
  "main": ".open-next/worker.js",
  "keep_names": false,
  "keep_vars": true,
  // Updated to 2025-04-01: enables nodejs_compat_populate_process_env by
  // default and includes the latest Workers runtime fixes.
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_process_v2"
    // nodejs_compat_populate_process_env is now ON by default for dates >= 2025-04-01
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production"
  }
}
